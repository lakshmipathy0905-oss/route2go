# Route2Go — Environment Variable Template
# Copy to .env (local) and fill in real values. NEVER commit a filled-in .env
# file — only this template belongs in git.

# --- Firebase ---
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key is SERVER-ONLY. Never put this in the Flutter app,
# never commit it, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Routing / Geocoding / Places ---
# Routing is Valhalla. VALHALLA_BASE_URL is preferred; ROUTING_PROVIDER_BASE_URL
# is honoured as a fallback for existing deployments. When neither is set the
# deterministic mock adapter is used (labelled `mock-dev-fixture`).
# Dev/test only: https://valhalla1.openstreetmap.de
# Production: your self-hosted instance (see infra/valhalla). Never a public demo.
VALHALLA_BASE_URL=
# Legacy alias accepted by getRoutingProvider() when VALHALLA_BASE_URL is unset.
ROUTING_PROVIDER_BASE_URL=
ROUTING_PROVIDER_KEY=
# Geocoding: any non-empty value enables the live Nominatim adapter (the value
# is used only as a flag; Nominatim itself needs no key). Keep unset to use the
# deterministic mock. Nominatim's public instance is dev/test only and strict
# (~1 req/sec, valid User-Agent, no bulk).
GEOCODING_PROVIDER_KEY=
PLACES_PROVIDER_KEY=

# --- Hotel / Affiliate ---
HOTEL_AFFILIATE_PARTNER_ID=
HOTEL_AFFILIATE_API_KEY=

# --- Push / Analytics / Crash ---
FCM_SERVER_KEY=
ANALYTICS_WRITE_KEY=

# --- Admin ---
ADMIN_ALLOWED_EMAIL_DOMAIN=

# --- Feature flags (mirror of supabase.feature_flags for local override) ---
USE_LIVE_FUEL_PRICES=false
USE_LIVE_TOLL_DATA=false

# --- Flutter app --dart-define values (for flutter run/build, not supabase) ---
# Map tiles: any XYZ tile host. Defaults to OpenStreetMap's public tiles
# (dev/test only — production should use a paid tile provider, see
# docs/TILE_PROVIDER_SETUP.md). Attribution must match the active provider.
# MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=Map data © OpenStreetMap contributors
# Geocoding source for the app: 'supabase' (default, routes through the
# /geocode edge function) or 'mock' (deterministic offline provider).
# GEOCODING_PROVIDER=supabase
